{
  "name": "orders-service",
  "version": "1.0.0",
  "description": "Orders microservice — owns order lifecycle, calls Users service to validate customers",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "test": "jest --testPathIgnorePatterns=pact",
    "test:pact": "jest --testPathPattern=pact --runInBand && npm run publish:pact",
    "test:all": "jest --runInBand",
    "publish:pact": "npx pact-broker publish ./pacts --consumer-app-version=1.0.0 --broker-base-url=http://localhost:9292"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^12.1.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
