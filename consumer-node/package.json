{
  "name": "consumer-node",
  "version": "1.0.0",
  "description": "Node/TS consumer microservice for Pact contract testing",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test:pact": "jest --testPathPattern=pact && npm run publish:pact",
    "test": "jest",
    "publish:pact": "npx pact-broker publish ./pacts --consumer-app-version=1.0.0 --broker-base-url=http://16.171.160.56:9292"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^12.1.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}
